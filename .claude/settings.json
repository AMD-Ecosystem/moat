{
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git push:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh repo view:*)",
      "Bash(gh repo clone:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh search:*)",
      "Bash(gh api:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(cmake:*)",
      "Bash(make:*)",
      "Bash(ninja:*)",
      "Bash(ctest:*)",
      "Bash(hipcc:*)",
      "Bash(hipify-perl:*)",
      "Bash(python3:*)",
      "Bash(python:*)",
      "Bash(pytest:*)",
      "Bash(rocminfo:*)",
      "Bash(rocm_agent_enumerator:*)",
      "Edit",
      "Write"
    ],
    "ask": [
      "Bash(gh api -X:*)",
      "Bash(gh api --method:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh repo create:*)",
      "Bash(gh repo delete:*)"
    ],
    "deny": [
      "Bash(git push -f:*)",
      "Bash(git push --force:*)",
      "Bash(gh repo fork:*)",
      "Bash(ghstack:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push*--force*)",
      "Bash(git push*--no-verify*)",
      "Bash(git push* upstream*)",
      "Bash(gh auth token:*)",
      "Bash(gh alias set:*)",
      "Bash(gh alias import:*)",
      "Bash(gh extension install:*)",
      "Bash(gh extension exec:*)",
      "Bash(curl*api.github.com*)",
      "Bash(*Invoke-RestMethod*api.github.com*)",
      "Bash(*Invoke-WebRequest*api.github.com*)",
      "PowerShell(*Invoke-RestMethod*api.github.com*)",
      "PowerShell(*Invoke-WebRequest*api.github.com*)",
      "Bash(*gh.exe*)",
      "Bash(*GitHub CLI/gh*)",
      "PowerShell(*gh.exe*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/utils/gh_hook.sh\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
