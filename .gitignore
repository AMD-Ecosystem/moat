# MOAT is a control-plane repo. It tracks tracking artifacts (status.json,
# plan.md, notes.md, stats.jsonl) but NOT the working clones of the forks or
# any scratch. The actual port lives in each project's AMD-Ecosystem fork.

projects/*/src/
projects/*/src-core/
projects/*/opencv_extra/
projects/*/build_hip.sh
projects/*/build/
projects/*/build-*/
projects/*/build_*/
projects/*/install/
projects/*/install-*/
projects/*/install_*/
projects/*/.lock
projects/*/.claim
projects/.selection.lock
agent_space/

# discover.py --code-search resumable checkpoint (per-repo meta + surfacing);
# regenerated each run, never a tracked artifact.
data/.code_search_cache.json

# Python
__pycache__/
*.pyc
*.pyo
_deps/
projects/rmcl/rmagine_src/

# clang/hip offload-bundle per-TU intermediates (never source)
*.o.0.*

# CMake build artifacts (by name, at any depth -- a validator that configures at
# the repo root or inside config/ drops these; never tracked content).
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
/Makefile
/solution-sum.json

# Root-litter guard. These accumulated one pattern at a time whenever a validator
# configured or ran a build from the repo root instead of agent_space/. The fix is
# the rule, not the list: builds belong under agent_space/. Kept as a coarse net so
# a stray run cannot reach a commit, rather than 40 project-specific patterns.
/build*/
/install*/
/bin/
/lib/
/app/
/cache/
/examples/
*.log
*.ply
*.ohm
*.vtk
/C*Config.cmake
/CTestTestfile.cmake
/cmake_install.cmake
/DartConfiguration.tcl
/Makefile

# Per-arch / compare scratch dirs created at the projects/ level instead of
# agent_space/ (these are not adopted projects -- adopted projects have a
# status.json and an upstream repo name, never a -gfx*/-build/-revalidate suffix).
projects/*-gfx1100/
projects/*-gfx90a/
projects/*-gfx1101/
projects/*-gfx1201/
projects/*-new-build/
projects/*-old-build/
projects/*-revalidate/
projects/*-converge/
projects/*-stage2-geom/
projects/*-cmp-*/

# Discovery audit trail: regenerated by utils/discover.py, kept local.
data/candidates.raw.jsonl
data/blindspot_candidates.json

# Prepared ROCm bug reports and reproducers. Held out of the public repo: 11 of 14
# are not yet filed, and publishing an unfiled report puts it where the component
# owners will not see it. They stay on disk and in the private history.
findings/

# Claude Code agent worktrees (isolated checkouts; their commits live on their own branches)
.claude/worktrees/
