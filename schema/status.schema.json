{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AMD-Ecosystem/moat/schema/status.schema.json",
  "title": "MOAT per-project status",
  "$comment": "GENERATED by utils/gen_schema.py from moatlib -- do not hand-edit.",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "upstream_url",
    "fork_default_branch",
    "priority",
    "ext_type",
    "platforms"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string"
    },
    "upstream_url": {
      "type": "string"
    },
    "fork_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "fork_default_branch": {
      "type": "string"
    },
    "fork_branch": {
      "type": "string",
      "description": "port branch when it is not moat-port"
    },
    "priority": {
      "type": "number"
    },
    "ext_type": {
      "type": "string",
      "minLength": 1
    },
    "adopted_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "head_sha": {
      "type": [
        "string",
        "null"
      ],
      "description": "current fork branch HEAD"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "on_hold": {
      "type": "boolean"
    },
    "on_hold_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "porting": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "arch",
        "since"
      ],
      "properties": {
        "arch": {
          "type": "string",
          "pattern": "^(linux|windows)-(gfx[0-9a-f]+)$"
        },
        "since": {
          "type": "string"
        }
      }
    },
    "waivers": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "windows"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string"
          },
          "approved_by": {
            "type": "string"
          },
          "at": {
            "type": "string"
          }
        }
      }
    },
    "license_spdx": {
      "type": [
        "string",
        "null"
      ]
    },
    "license_clearance": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "approved_by",
        "at"
      ],
      "properties": {
        "approved_by": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string"
        },
        "tier": {
          "type": "integer"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "pr_state": {
      "enum": [
        "open",
        "merged",
        "closed"
      ]
    },
    "pr_url": {
      "type": "string"
    },
    "pr_number": {
      "type": "integer"
    },
    "pr_opened_at": {
      "type": "string"
    },
    "pr_merged_at": {
      "type": "string"
    },
    "pr_closed_at": {
      "type": "string"
    },
    "pr_closed_note": {
      "type": "string"
    },
    "review_pr": {
      "type": "string"
    },
    "pr_approval": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "approved_by",
        "at",
        "head_sha",
        "content_sha256"
      ],
      "properties": {
        "approved_by": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string"
        },
        "head_sha": {
          "type": "string"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "review_pr": {
          "type": "string"
        }
      }
    },
    "platforms": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(linux|windows)-(gfx[0-9a-f]+)$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/arch"
      }
    }
  },
  "$defs": {
    "state": {
      "enum": [
        "awaiting-fork",
        "awaiting-port",
        "awaiting-upstream",
        "changes-requested",
        "completed",
        "delta-ported",
        "planned",
        "port-ready",
        "ported",
        "porting",
        "revalidate",
        "review-passed",
        "screened",
        "unclaimed",
        "validation-failed"
      ]
    },
    "arch": {
      "type": "object",
      "required": [
        "state",
        "blocked"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "blocked": {
          "type": "boolean"
        },
        "blocked_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "validated_sha": {
          "type": [
            "string",
            "null"
          ],
          "description": "head this arch last validated"
        },
        "pr_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "pr_number": {
          "type": [
            "number",
            "null"
          ]
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_agent": {
          "type": [
            "string",
            "null"
          ]
        },
        "carry_forward": {
          "type": "object"
        },
        "stats": {
          "type": "object"
        }
      }
    }
  }
}
