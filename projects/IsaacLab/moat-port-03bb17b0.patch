+def supports_graph_capture(device: wp.DeviceLike = None) -> bool:
+    """Whether Warp can capture and replay CUDA graphs on a GPU device.
+
+    Warp builds for ROCm report HIP devices as CUDA devices but run :class:`warp.ScopedCapture` eagerly without
+    producing a graph, which they report through ``Device.supports_graph_capture``. Warp builds without that attribute
+    capture on every CUDA device.
+
+    Args:
+        device: Warp device. Defaults to the current device.
+
+    Returns:
+        True if ``device`` is a CUDA device that supports graph capture.
+    """
+    device = wp.get_device(device)
+    return device.is_cuda and getattr(device, "supports_graph_capture", True)
