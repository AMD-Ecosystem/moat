--- a/source/isaaclab/isaaclab/utils/warp/utils.py
+++ b/source/isaaclab/isaaclab/utils/warp/utils.py
@@ -43,3 +43,20 @@ def capture_unsafe(reason: str | None = None):
         return wrapper
 
     return decorator
+
