+def skip_without_graph_capture(device: str) -> None:
+    """Skip the rest of the current test when Warp cannot capture CUDA graphs on ``device``.
+
+    Call it immediately before a capture, so the eager checks earlier in the test still run on such devices.
+
+    Args:
+        device: Warp device the test captures on.
+    """
+    import pytest
+
+    from isaaclab.utils.warp.utils import supports_graph_capture
+
+    if not supports_graph_capture(device):
+        pytest.skip(f"Warp cannot capture CUDA graphs on {device}.")
+
+
