  "waivers": {
    "windows": {
      "reason": "At 9470225 upstream's Triton dispatch is Linux-only for every vendor (sys.platform != 'linux' returns False in _cuda_uses_triton, and the package declares Triton only on Linux), so on Windows AMD and NVIDIA GPU inputs take the SciPy CPU fallback by upstream design. The round's one change (accept a ROCm torch in the dispatch check) is never reached on Windows; a Windows run can only show the fallback, not a GPU pass. The earlier Windows records were for the legacy extension, which the 0.1.0 merge removed.",
      "suggested_at": "2026-11-23T19:00:02Z",
      "approved_by": "jeffdaily",
      "at": "2026-11-23T19:00:03Z"
    }
  },
